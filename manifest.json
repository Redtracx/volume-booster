{
  "manifest_version": 2,
  "name": "Volume Booster",
  "version": "1.0.0",
  "description": "Lautstärke von Tabs über 100% hinaus boosten – pro Seite einstellbar über das Toolbar-Popup.",
  "browser_specific_settings": {
    "gecko": {
      "id": "volume-booster@redtracx.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["storage", "<all_urls>"],
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_action": {
    "default_icon": "icons/icon.svg",
    "default_popup": "popup/popup.html",
    "default_title": "Volume Booster"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/boost.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
